<?xml version="1.0" encoding="utf-8"?>
<!-- A big white ball sitting on a thin horizon line, a small person beside it (about a third of the
     ball's height), a pale highlight arc on the ball. Safe zone = the central 66 dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
