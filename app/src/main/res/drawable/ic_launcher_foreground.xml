    <path
        android:pathData="M22,76H86"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <!-- the ball, resting on the horizon -->
    <path
        android:pathData="M62,57m-19,0a19,19 0 1,1 38,0a19,19 0 1,1 -38,0"
        android:fillColor="#FFFFFFFF" />
    <!-- highlight arc on the ball -->
    <path
        android:pathData="M51,50A13,13 0 0,1 61,43.5"
        android:strokeColor="#FFA9D3F5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- the person: head + body, about a third of the ball's height -->
    <path
        android:pathData="M33,60.5m-2.6,0a2.6,2.6 0 1,1 5.2,0a2.6,2.6 0 1,1 -5.2,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M30,76V67.5a3,3 0 0,1 3,-3a3,3 0 0,1 3,3V76z"
        android:fillColor="#FFFFFFFF" />
</vector>
